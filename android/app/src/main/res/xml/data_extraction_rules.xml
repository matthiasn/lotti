<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 and higher
  (android:dataExtractionRules). The reasons for each exclusion are in
  backup_rules.xml, the Android 11-and-lower twin; keep the two in step.
  Device transfer excludes the same paths: a transferred Matrix store would
  give two phones one Matrix device identity.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_flutter/matrix" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_flutter/matrix" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </device-transfer>
</data-extraction-rules>
