-- One row per indexed journal entity: the filters a search applies before
-- ranking (so a LIMIT keeps the best matches the caller can show), and the
-- rowid that keys the entity's text in `search_fts`.
CREATE TABLE search_doc (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  entity_id TEXT NOT NULL UNIQUE,
  type TEXT NOT NULL,
  category_id TEXT NOT NULL DEFAULT '',
  private BOOLEAN NOT NULL DEFAULT FALSE,
  date_from INTEGER NOT NULL
) AS SearchDocRow;

CREATE INDEX idx_search_doc_type_category ON search_doc(type, category_id);

-- The searchable text, keyed by `search_doc.id`. Diacritics fold in both
-- directions (`remove_diacritics 2`), and two- and three-character prefix
-- indexes keep the as-you-type prefix match the query builder emits cheap.
-- The text is stored, not contentless, so a result can show a snippet.
CREATE VIRTUAL TABLE search_fts USING fts5(
  title,
  body,
  extra,
  tokenize = 'unicode61 remove_diacritics 2',
  prefix = '2 3'
);

-- Titles alone, in trigrams: a title matches on any three letters of it, in
-- the middle of a word too, and a misspelt one by the trigrams it shares —
-- what jumping to a task by a fragment of its name needs. Keyed by
-- `search_doc.id`, like `search_fts`; only entities with a title have a row.
CREATE VIRTUAL TABLE title_trigram USING fts5(
  title,
  tokenize = 'trigram remove_diacritics 1'
);

-- Progress of a full rebuild: the journal rowid the next batch starts after,
-- or no row once the index has caught up with the journal.
CREATE TABLE search_index_state (
  name TEXT NOT NULL PRIMARY KEY,
  int_value INTEGER NOT NULL
);

searchDocByEntityId:
SELECT * FROM search_doc WHERE entity_id = :entityId;

deleteSearchText:
DELETE FROM search_fts WHERE rowid = :rowId;

deleteSearchDoc:
DELETE FROM search_doc WHERE id = :rowId;

insertSearchText:
INSERT INTO search_fts(rowid, title, body, extra)
  VALUES(:rowId, :title, :body, :extra);

indexStateValue:
SELECT int_value FROM search_index_state WHERE name = :name;

setIndexStateValue:
INSERT OR REPLACE INTO search_index_state(name, int_value)
  VALUES(:name, :intValue);

clearIndexStateValue:
DELETE FROM search_index_state WHERE name = :name;

deleteTitleTrigram:
DELETE FROM title_trigram WHERE rowid = :rowId;

insertTitleTrigram:
INSERT INTO title_trigram(rowid, title) VALUES(:rowId, :title);
